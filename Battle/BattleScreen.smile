''' Game navigation and music around the shared Studio Battle System.
Module SinStarI.BattleScreen

Option Explicit

Import Smile.Tools.Character3DViewerWorkflow As Workflow
Import Smile.Tools.NativeViewerHost As NativeHost
Import Smile.UI.Controls As UI
Import SinStarI.BackgroundMusic As BackgroundMusic

Private Dim Viewer As Workflow.Session
Private Dim Host As NativeHost.Session
Private Dim Active As Boolean

Public Sub Enter()

    If Active Then
        Call Shutdown()
    End If

    If Not Window_Loading() Then
        Return
    End If

    If Host Is Nothing Then
        Host = New NativeHost.Session()
    End If

    Viewer = New Workflow.Session()

    Call Host.Start(Viewer, NativeHost.BATTLE_TAB, True, Window_Width(), Window_Height(), False)
    Call BackgroundMusic.SelectTrack("Starforge Ascend (Kael)")

    Active = True

End Sub

Public Function HasEdits() As Boolean

    Dim Result As Boolean

    If Active Then
        Result = Viewer.HasEdits()
    End If

    Return Result

End Function

Public Function BackRequested(Key As Number) As Boolean

    Dim Result As Boolean

    If Not Active Then
        Return False
    End If

    If Not Host.CanLeaveBattle(Viewer) Then
        Return False
    End If

    Result = Key = KEY_ESCAPE Or UI.Clicked(18, 62, 110, 26)

    Return Result

End Function

Public Sub Update(Key As Number)

    If Active Then
        Call Host.StandaloneInput(Viewer, Key)
        Call Host.UpdateFrame(Viewer, Window_Width(), Window_Height())
    End If

End Sub

Public Sub Draw()

    If Not Active Then
        Return
    End If

    Call Host.DrawFrame(Viewer)
    Call Host.DrawStandaloneOverlay(Viewer)

    If Not Host.HeaderVisible() Then
        Return
    End If

    If Viewer.PanelVisibility() = 2 Then
        Draw Text "Sin Star I - Battle System" At 18, 12 Size 22 Color WHITE
    End If

    If Host.CanLeaveBattle(Viewer) Then
        Call UI.DrawButton(18, 62, 110, 26, "< Title", False)
    End If

End Sub

Public Sub Shutdown()

    If Active Then
        Call Host.Release(Viewer)
    End If

    Viewer = Nothing
    Active = False

End Sub

End Module
